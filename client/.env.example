# The API's origin, and nothing more — no /api, no trailing slash. Call sites
# write the /api/... path themselves, so moving the client and the API behind a
# single hostname later is this value becoming empty. See 0009.
#
# Use localhost on BOTH sides in development. localhost:3000 -> localhost:8000
# is same-site (a port is not part of a site), so the session cookie is sent.
# 127.0.0.1:3000 -> localhost:8000 is cross-site and the browser drops it
# silently: you appear signed out immediately after signing in.
#
# Next inlines this at BUILD time. Changing it means rebuilding the image; a
# restart does nothing. See §2 of docs/deployment-checklist.md.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional. Where server components reach the API. Only needed when the client
# runs where "localhost" isn't the API, like in docker compose, where it is
# http://server:8000. Unset, it falls back to NEXT_PUBLIC_API_URL. Read at
# runtime, so a restart picks up a change.
# API_INTERNAL_URL=http://server:8000
