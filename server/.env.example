# Copy to server/.env and fill in. server/.env is gitignored — keep it that way.

# Server
PORT=8000

# The Next dev server origin. Passed straight to cors({ origin }), so if the
# client runs on another port the browser will start rejecting responses.
CORS_ORIGIN=http://localhost:3000

# MongoDB Atlas connection string. Ask in the team chat; never commit it.
# Required — the server refuses to boot without it rather than quietly falling
# back to an empty local database. For a local mongod, set it explicitly:
#   MONGO_URI=mongodb://localhost:27017/mjolnir
MONGO_URI=

# How many reverse proxies stand in front of this server. 0 is right for a local
# run and for docker compose, where nothing does. It is the only way Express can
# work out a caller's real address, and rate limiting is keyed on that address:
# leave it too low behind a proxy and every user in the world shares one bucket.
#
# Always a count, never "true". A count is read from the right of
# X-Forwarded-For, where the proxy's own entries sit; "true" takes the leftmost
# entry, which the caller writes, so anyone could mint themselves a fresh
# budget. See docs/decisions/0007 and docs/deployment-checklist.md.
TRUST_PROXY_HOPS=0

# Signs the session cookie. Required — the server refuses to boot without it.
# Per-developer, not shared: generate your own and never commit it.
#   node -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
JWT_SECRET=

# Google OAuth (optional). Without all three, /auth/google answers 503 and the
# rest of the server is unaffected. Create a Web application client at
# console.cloud.google.com and register the redirect URI below verbatim.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Ingestion Pipeline (optional) ---
# Where downloaded TOR PDFs are stored. Default: server/data/documents
# DOCUMENTS_DIR=./data/documents
