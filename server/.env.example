# Copy to server/.env and fill in. server/.env is gitignored — keep it that way.

# Server
PORT=8000

# The Next dev server origin.
# Not read by server.js yet: cors() currently allows every origin.
CORS_ORIGIN=http://localhost:3000

# MongoDB Atlas connection string. Ask in the team chat; never commit it.
# If this is unset the server falls back to a local mongod and still boots.
MONGO_URI=
