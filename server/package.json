{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "src/server.js",
  "imports": {
    "#common/*": "./src/common/*",
    "#models/*": "./src/models/*",
    "#features/*": "./src/features/*",
    "#pipeline/*": "./src/pipeline/*"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "role": "node scripts/grant-role.js",
    "ingest": "node src/pipeline/ingestion/ingest.js",
    "ingest:fetch": "node src/pipeline/ingestion/ingest.js --step fetch",
    "ingest:download": "node src/pipeline/ingestion/ingest.js --step download",
    "ingest:ocr": "node src/pipeline/ingestion/ingest.js --step ocr",
    "ingest:add": "node src/pipeline/ingestion/ingest.js --step add",
    "history:import": "node src/pipeline/ingestion/import-history.js",
    "agencies:fetch": "node scripts/fetch-egp-agencies.js",
    "gemini:check": "node scripts/check-gemini.js",
    "technologies:seed": "node scripts/seed-technologies.js",
    "extract": "node src/pipeline/extraction/extract.js",
    "screen": "node src/pipeline/extraction/screen.js",
    "pipeline": "npm run ingest:fetch -- --source process3 && npm run screen && npm run ingest:download && npm run ingest:ocr && npm run extract && npm run ingest:ocr && npm run extract",
    "job": "node src/pipeline/jobs/run-job.js",
    "schedule": "node scripts/run-schedule.js",
    "report": "node scripts/pipeline-report.js",
    "seed": "node scripts/seed.js",
    "seed:comparable": "node scripts/seed-comparable-test.js",
    "comparable": "node scripts/find-comparable.js"
  },
  "dependencies": {
    "@google/genai": "^2.25.0",
    "adm-zip": "^0.6.0",
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^5.6.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "fast-xml-parser": "^4.5.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.4",
    "pdf-parse": "^2.4.5",
    "pdf-to-img": "^7.0.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
